# DSP-27 — matriz de desarrollo (copiar a envs/shared.env para overrides locales)
NODE_ENV=development

# Puertos
PORT=5080
API_PREFIX=api
TIMEZONE=America/Santiago
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENABLE_CORS=true

# Database (Postgres + PostGIS)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dsp
DB_PASSWORD=dsp123
DB_DATABASE=dsp27
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=60000

# JWT
JWT_SECRET=dsp27-dev-jwt-secret-change-me
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:5081
CORS_CREDENTIALS=true

# Storage (un driver activo)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
MEDIA_MAX_FILE_SIZE=20971520
MEDIA_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Seed (solo local)
DSP_SEED_ADMIN_USERNAME=direccion
DSP_SEED_ADMIN_PASSWORD=direccion123
DSP_SEED_ADMIN_EMAIL=direccion@dsp.local
DSP_SEED_GESTOR_PASSWORD=gestor123
DSP_SEED_PREVENCION_PASSWORD=prevencion123

# Microsoft Graph (OAuth delegado — Conectar Outlook)
# Vacío = integración deshabilitada; el core arranca igual.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:5080/api/integrations/microsoft/callback
MS_APP_REDIRECT_URI=http://localhost:5081/settings
MS_TOKEN_ENCRYPTION_KEY=dsp27-dev-ms-token-encryption-key-32b
# Overlay calendario de equipo (Application Calendars.Read + admin consent)
MS_APP_ONLY_CALENDAR=false

# Notificaciones (WS + outbox email)
NOTIFICATION_DEDUP_WINDOW_MINUTES=15
NOTIFICATION_OUTBOX_POLL_MS=15000
NOTIFICATION_OUTBOX_BATCH_SIZE=20
